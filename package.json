{
  "name": "merchant-ops",
  "version": "1.0.0",
  "description": "Open-source backend platform for small-business order and payment operations.",
  "main": "index.js",
  "scripts": {
  "test": "jest",
  "lint": "eslint .",
  "build": "tsc",
  "start": "node dist/server.js",
  "migration:create": "node-pg-migrate create",
  "migration:up": "node-pg-migrate up --envPath .env --database-url-var DATABASE_URL",
  "migration:down": "node-pg-migrate down --envPath .env --database-url-var DATABASE_URL"
},
